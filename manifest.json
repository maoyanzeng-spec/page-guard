{
  "manifest_version": 3,
  "name": "Page Guard",
  "version": "1.0",
  "description": "Scans webpages for suspicious elements and shows a risk score.",

  "permissions": ["storage", "tabs"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["badge.css"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Guard"
  }
}
